{
  "name": "handshook-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "build:store": "vite build --mode store && vite build --config vite.content.config.ts --mode store",
    "package:store": "npm run build:store && cd dist && zip -rX ../handshook-store.zip . && echo 'Store zip: frontend/handshook-store.zip'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.327",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
