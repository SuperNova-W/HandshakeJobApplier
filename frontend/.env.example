# Public OAuth configuration embedded into dist/manifest.json at build time.
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com

# Optional but recommended for a stable unpacked extension ID.
# Copy the Chrome Web Store public key without BEGIN/END lines or whitespace.
GOOGLE_EXTENSION_PUBLIC_KEY=

# Deployed backend base URL: the ApiUrl output of backend/deploy.sh, including
# its /Prod stage path. Leave unset for local development (the extension then
# defaults to http://127.0.0.1:8765). Required for `npm run build:store`.
# VITE_BACKEND_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/Prod
