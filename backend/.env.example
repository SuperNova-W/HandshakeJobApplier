# Google OAuth client ID must match frontend/.env.
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com

# Optional: path to the local SQLite database file (created on first run).
# Defaults to data/handshook.db relative to the backend working directory.
HANDSHOOK_DB_PATH=data/handshook.db

# Optional stable signing key. Use at least 32 random characters.
AUTH_TOKEN_SECRET=

# Optional: AI document generation.
OPENAI_API_KEY=
