<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.4</version>
    <relativePath />
  </parent>

  <groupId>com.handshook</groupId>
  <artifactId>backend</artifactId>
  <version>0.1.0</version>
  <name>handshook-backend</name>
  <description>Local Spring Boot companion API for the HandShook extension</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- OpenAI cover-letter generation uses Spring's RestClient (ships with
         spring-boot-starter-web) to call the Chat Completions API directly — no
         vendor SDK dependency needed. -->

    <!-- OpenPDF (LGPL/MPL) — renders the generated cover-letter text to a PDF so
         the extension can attach it as a real file in Handshake's apply modal. -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>1.3.30</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- `mvn -Plambda clean package` builds the AWS Lambda artifact: a zip of
         target/classes plus lib/*.jar (Lambda puts lib/ jars on the classpath),
         handled by the library's SpringDelegatingLambdaContainerHandler (no
         handler code in this repo; template.yaml sets MAIN_CLASS). The default
         build is untouched, so run.sh keeps producing the normal local jar. -->
    <profile>
      <id>lambda</id>
      <properties>
        <!-- The Lambda zip replaces Spring Boot's repackaged fat jar. -->
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.amazonaws.serverless</groupId>
          <artifactId>aws-serverless-java-container-springboot3</artifactId>
          <version>2.1.5</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.7.1</version>
            <executions>
              <execution>
                <id>lambda-zip</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <descriptors>
                    <descriptor>src/assembly/lambda.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
